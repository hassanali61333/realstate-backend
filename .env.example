# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/propchat

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Allowed frontend origin (CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# Public base URL of this server (used to build upload URLs if needed)
SERVER_URL=http://localhost:5000
